<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Shell School | Learn PowerShell</Title>
	<style>
		:root {
			--ink: #18212b;
			--muted: #65717d;
			--line: #dbe4e8;
			--paper: #f7faf9;
			--panel: #ffffff;
			--navy: #17324d;
			--blue: #2476a9;
			--teal: #1e9b8a;
			--yellow: #e9bd57;
			--coral: #ef785f;
			--shadow: 0 16px 40px rgba(23, 50, 77, .09);
		}

		* { box-sizing: border-box; }
		body {
			margin: 0;
			color: var(--ink);
			background: var(--paper);
			font-family: Georgia, "Times New Roman", serif;
			background-image: radial-gradient(circle at 85% 9%, rgba(233,189,87,.18) 0 90px, transparent 91px), linear-gradient(135deg, transparent 0 68%, rgba(30,155,138,.07) 68% 100%);
		}
		button, input { font: inherit; }
		button { cursor: pointer; }
		.app-shell { max-width: 1440px; margin: auto; padding: 28px 5vw 48px; }
		.topbar { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-bottom: 54px; }
		.brand { display: flex; align-items: center; gap: 13px; color: var(--navy); text-decoration: none; font-weight: bold; font-size: 1.1rem; }
		.brand-mark { width: 38px; height: 38px; display: grid; place-items: center; color: #fff; background: var(--navy); border-radius: 11px 11px 11px 3px; font: bold 1.2rem/1 Georgia, serif; }
		.nav-note { color: var(--muted); font: 600 .78rem/1.2 Arial, sans-serif; letter-spacing: .08em; text-transform: uppercase; }
		.hero { max-width: 890px; margin-bottom: 38px; }
		.eyebrow { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; color: var(--teal); font: bold .76rem/1 Arial, sans-serif; letter-spacing: .16em; text-transform: uppercase; }
		.eyebrow::before { content: ""; display: block; width: 31px; height: 2px; background: var(--coral); }
		h1 { max-width: 780px; margin: 0 0 18px; color: var(--navy); font-size: clamp(2.9rem, 6vw, 5.4rem); font-weight: 500; letter-spacing: -0.02em; line-height: .94; }
		.hero-copy { max-width: 610px; margin: 0; color: var(--muted); font-size: 1.18rem; line-height: 1.55; }
		.workspace { display: grid; grid-template-columns: minmax(220px, 285px) minmax(0, 1fr); gap: 20px; align-items: start; }
		.panel { background: var(--panel); border: 1px solid var(--line); box-shadow: var(--shadow); }
		.library { padding: 22px; }
		.library-heading { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 16px; }
		.library h2, .lesson h2 { margin: 0; color: var(--navy); font-size: 1.35rem; font-weight: 500; }
		.count { color: var(--muted); font: 700 .7rem/1 Arial, sans-serif; }
		.search { width: 100%; border: 1px solid var(--line); border-radius: 7px; padding: 10px 12px; color: var(--ink); outline: none; font: .88rem Arial, sans-serif; background: #fbfdfd; }
		.search:focus { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(36,118,169,.13); }
		.command-list { display: grid; gap: 6px; margin-top: 17px; }
		.command-item { display: flex; align-items: center; gap: 11px; width: 100%; border: 0; border-radius: 7px; padding: 11px 10px; color: var(--ink); background: transparent; text-align: left; }
		.command-item:hover, .command-item.active { background: #e8f4f1; }
		.command-item.active { box-shadow: inset 3px 0 var(--teal); }
		.command-icon { display: grid; place-items: center; width: 27px; height: 27px; flex: 0 0 27px; border-radius: 7px; color: var(--navy); background: #f5e8bd; font: bold .77rem Arial, sans-serif; }
		.command-label { font: 700 .86rem Arial, sans-serif; }
		.command-detail { display: block; margin-top: 3px; color: var(--muted); font: .72rem Arial, sans-serif; }
		.empty { color: var(--muted); font: .82rem Arial, sans-serif; }
		.lesson { min-width: 0; padding: 34px; }
		.lesson-header { display: flex; justify-content: space-between; align-items: start; gap: 20px; margin-bottom: 27px; }
		.lesson-kicker { margin-bottom: 8px; color: var(--coral); font: bold .73rem Arial, sans-serif; letter-spacing: .11em; text-transform: uppercase; }
		.lesson h2 { font-size: 2rem; }
		.lesson-intro { max-width: 600px; margin: 8px 0 0; color: var(--muted); font-size: 1rem; line-height: 1.5; }
		.level { flex: 0 0 auto; padding: 8px 11px; color: var(--navy); background: #fff4d5; border: 1px solid #f0d993; border-radius: 99px; font: bold .7rem Arial, sans-serif; }
		.lesson-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(215px, .45fr); gap: 20px; }
		.terminal-wrap { overflow: hidden; border-radius: 8px; background: var(--navy); }
		.terminal-top { display: flex; justify-content: space-between; align-items: center; padding: 12px 15px; color: #c8d8e2; background: #10263b; font: .7rem Arial, sans-serif; }
		.lights { display: flex; gap: 5px; }
		.lights i { width: 7px; height: 7px; border-radius: 50%; background: var(--coral); }
		.lights i:nth-child(2) { background: var(--yellow); }
		.lights i:nth-child(3) { background: var(--teal); }
		.terminal-body { min-height: 211px; padding: 19px 20px; color: #eaf2f4; font: .93rem/1.65 "Courier New", monospace; }
		.prompt { color: #73d6bf; }
		.command-text { color: #fff1bb; }
		.output { margin-top: 13px; color: #bdcad3; white-space: pre-wrap; }
		.run-row { display: flex; gap: 10px; margin-top: 15px; }
		.command-input { min-width: 0; flex: 1; border: 1px solid #3c5c71; border-radius: 6px; padding: 12px; color: #f6fbfa; background: #1e425a; outline: none; font: .86rem "Courier New", monospace; }
		.command-input:focus { border-color: var(--teal); box-shadow: 0 0 0 3px rgba(30,155,138,.18); }
		.run-button { border: 0; border-radius: 6px; padding: 0 17px; color: var(--navy); background: var(--yellow); font: bold .82rem Arial, sans-serif; }
		.run-button:hover { background: #f3ce6d; }
		.explain { border-left: 3px solid var(--teal); padding: 3px 0 3px 17px; }
		.explain-label { margin-bottom: 12px; color: var(--teal); font: bold .7rem Arial, sans-serif; letter-spacing: .13em; text-transform: uppercase; }
		.explain p { margin: 0; color: var(--muted); font-size: .97rem; line-height: 1.55; }
		.tip { margin-top: 23px; padding-top: 20px; border-top: 1px solid var(--line); }
		.tip strong { display: block; margin-bottom: 5px; color: var(--navy); font: bold .76rem Arial, sans-serif; letter-spacing: .08em; text-transform: uppercase; }
		.tip span { color: var(--muted); font-size: .9rem; line-height: 1.45; }
		.progress { display: flex; align-items: center; gap: 12px; margin-top: 25px; color: var(--muted); font: .72rem Arial, sans-serif; }
		.progress-bar { height: 6px; flex: 1; max-width: 170px; overflow: hidden; border-radius: 99px; background: #e5ecee; }
		.progress-fill { width: 25%; height: 100%; background: var(--teal); transition: width .3s ease; }
		@media (max-width: 820px) {
			.app-shell { padding: 22px 20px 36px; }
			.topbar { margin-bottom: 38px; }
			.nav-note { display: none; }
			.workspace, .lesson-grid { grid-template-columns: 1fr; }
			.library { order: 2; }
			.lesson { padding: 24px 20px; }
			.lesson-header { display: block; }
			.level { display: inline-block; margin-top: 15px; }
		}
		@media (max-width: 450px) {
			h1 { font-size: 3rem; }
			.hero-copy { font-size: 1rem; }
			.terminal-body { padding: 15px; }
			.run-row { flex-direction: column; }
			.run-button { min-height: 42px; }
		}
	</style>
</head>
<body>
	<main class="app-shell">
		<header class="topbar">
			<a class="brand" href="#"><span class="brand-mark">&gt;_</span><span>Shell School</span></a>
			<span class="nav-note">A calm place to get command-line curious</span>
		</header>

		<section class="hero">
			<div class="eyebrow">PowerShell, made plain</div>
			<h1>Small commands.<br>Big confidence.</h1>
			<p class="hero-copy">A hands-on pocket guide for learning the PowerShell basics. Pick a command, see what it does, then try it in a safe little sandbox.</p>
		</section>

		<section class="workspace" aria-label="PowerShell lesson workspace">
			<aside class="panel library">
				<div class="library-heading"><h2>Command shelf</h2><span class="count" id="commandCount">04 COMMANDS</span></div>
				<input class="search" id="searchInput" type="search" placeholder="Find a command..." aria-label="Find a command">
				<div class="command-list" id="commandList"></div>
			</aside>

			<article class="panel lesson">
				<div class="lesson-header">
					<div>
						<div class="lesson-kicker" id="lessonKicker">Lesson 01 / Getting oriented</div>
						<h2 id="lessonTitle">Get-Location</h2>
						<p class="lesson-intro" id="lessonIntro">Find out where you are in the file system. Think of it as asking, “What folder am I standing in?”</p>
					</div>
					<span class="level" id="lessonLevel">STARTER</span>
				</div>

				<div class="lesson-grid">
					<div>
						<div class="terminal-wrap">
							<div class="terminal-top"><span class="lights"><i></i><i></i><i></i></span><span>powershell — learner sandbox</span></div>
							<div class="terminal-body">
								<div><span class="prompt">PS C:\learn&gt; </span><span class="command-text" id="terminalCommand">Get-Location</span></div>
								<div class="output" id="terminalOutput">Path
----
C:\learn</div>
							</div>
						</div>
						<div class="run-row">
							<input class="command-input" id="commandInput" value="Get-Location" aria-label="PowerShell command to try">
							<button class="run-button" id="runButton" type="button">Run example</button>
						</div>
					</div>
					<div class="explain">
						<div class="explain-label">In plain English</div>
						<p id="lessonExplanation">Get-Location reports your current working directory. It does not change anything; it just tells you where PowerShell is looking.</p>
						<div class="tip"><strong>Try this next</strong><span id="lessonTip">Run the example, then change the command to <b>Get-Location</b> again. Notice the prompt shows the same folder.</span></div>
					</div>
				</div>
				<div class="progress"><span id="progressText">1 of 4 explored</span><div class="progress-bar"><div class="progress-fill" id="progressFill"></div></div></div>
			</article>
		</section>
	</main>

	<script>
		const commands = [
			{ name: "Get-Location", icon: "01", kicker: "Lesson 01 / Getting oriented", level: "STARTER", intro: "Find out where you are in the file system. Think of it as asking, \"What folder am I standing in?\"", explanation: "Get-Location reports your current working directory. It does not change anything; it just tells you where PowerShell is looking.", output: "Path\n----\nC:\\learn", tip: "Run the example, then change the command to Get-Location again. Notice the prompt shows the same folder." },
			{ name: "Get-ChildItem", icon: "02", kicker: "Lesson 02 / Looking around", level: "STARTER", intro: "See the files and folders inside your current location. This is your PowerShell version of opening a folder.", explanation: "Get-ChildItem lists items in a folder. The shorter alias \"dir\" works too, but the full name is easier to remember while learning.", output: "Mode   LastWriteTime   Name\n----   -------------   ----\nd----                  lessons\n-a---                  notes.txt", tip: "Try dir as a shortcut. It is an alias for Get-ChildItem." },
			{ name: "New-Item", icon: "03", kicker: "Lesson 03 / Making a file", level: "BEGINNER", intro: "Create a new file or folder. PowerShell commands often read like tiny sentences.", explanation: "New-Item creates something new. Add -ItemType Directory when you want a folder; use -Name to give the new item a name.", output: "    Directory: C:\\learn\n\nMode   Name\n----   ----\nd----  practice", tip: "Try New-Item -Name practice -ItemType Directory to make a practice folder." },
			{ name: "Get-Help", icon: "04", kicker: "Lesson 04 / Asking for help", level: "ESSENTIAL", intro: "When you forget a command, ask PowerShell itself. Help is built into the shell.", explanation: "Get-Help shows documentation for a command. Add -Examples to see practical ways to use it, or -Online for the full web reference.", output: "NAME\n    Get-Location\n\nSYNOPSIS\n    Gets the current working location.", tip: "Try Get-Help Get-ChildItem -Examples to see useful examples." }
		];
		let selected = 0;
		const explored = new Set([0]);
		const list = document.getElementById("commandList");
		const search = document.getElementById("searchInput");
		function renderList() {
			const query = search.value.toLowerCase();
			const visible = commands.map((command, index) => ({ command, index })).filter(item => item.command.name.toLowerCase().includes(query));
			list.innerHTML = visible.length ? visible.map(({ command, index }) => `<button class="command-item ${index === selected ? "active" : ""}" data-index="${index}"><span class="command-icon">${command.icon}</span><span><span class="command-label">${command.name}</span><span class="command-detail">${command.level.toLowerCase()}</span></span></button>`).join("") : `<p class="empty">No commands found.</p>`;
			list.querySelectorAll(".command-item").forEach(item => item.addEventListener("click", () => selectCommand(Number(item.dataset.index))));
			document.getElementById("commandCount").textContent = `${visible.length.toString().padStart(2, "0")} COMMANDS`;
		}
		function selectCommand(index) {
			selected = index;
			explored.add(index);
			const command = commands[index];
			document.getElementById("lessonKicker").textContent = command.kicker;
			document.getElementById("lessonTitle").textContent = command.name;
			document.getElementById("lessonLevel").textContent = command.level;
			document.getElementById("lessonIntro").textContent = command.intro;
			document.getElementById("lessonExplanation").textContent = command.explanation;
			document.getElementById("lessonTip").innerHTML = command.tip;
			document.getElementById("terminalCommand").textContent = command.name;
			document.getElementById("terminalOutput").textContent = command.output;
			document.getElementById("commandInput").value = command.name;
			document.getElementById("progressText").textContent = `${explored.size} of ${commands.length} explored`;
			document.getElementById("progressFill").style.width = `${(explored.size / commands.length) * 100}%`;
			renderList();
		}
		document.getElementById("runButton").addEventListener("click", () => {
			const input = document.getElementById("commandInput").value.trim() || "Get-Location";
			document.getElementById("terminalCommand").textContent = input;
			document.getElementById("terminalOutput").textContent = commands[selected].output;
			document.getElementById("runButton").textContent = "Ran safely";
			setTimeout(() => document.getElementById("runButton").textContent = "Run example", 1200);
		});
		search.addEventListener("input", renderList);
		renderList();
	</script>
</body>
</html>
